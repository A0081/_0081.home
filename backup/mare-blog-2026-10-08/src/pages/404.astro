---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "404 - Page Not Found";
---

<BaseLayout pageTitle={pageTitle} hidePageHeader>
  <div class="text-center">
    <h1 class="mb-2 text-8xl font-bold">404</h1>
    <h3 class="text-2xl">你访问的页面不存在。</h3>
    <a class="btn btn-primary mt-9" href="/">返回首页</a>
  </div>
</BaseLayout>
