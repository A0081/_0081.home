---
import siteConfig from "@config";
import "nprogress/nprogress.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import Comment from "../components/Comments.astro";
import SearchPanel from "../components/SearchPanel.astro";
import GlobalTooltip from "../components/GlobalTooltip.astro";
import BackToTop from "../components/BackToTop.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  pageTitle: string;
  description?: string;
  showComments?: boolean;
  hidePageHeader?: boolean;
}

const {
  pageTitle,
  description,
  showComments = false,
  hidePageHeader = false,
} = Astro.props;

const metaDescription = description ?? siteConfig.description;
const lang = siteConfig.lang ?? "en";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const activeHref = siteConfig.nav
  .map((item) => item.href.replace(/\/$/, "") || "/")
  .filter((href) =>
    href === "/"
      ? currentPath === "/"
      : currentPath === href || currentPath.startsWith(`${href}/`),
  )
  .sort((left, right) => right.length - left.length)[0];
---

<!doctype html>
<html lang={lang} data-theme="lofi">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    <title>{pageTitle} - {siteConfig.title}</title>
    <ClientRouter />

    <script is:inline>
      const applyTheme = () => {
        const stored =
          typeof localStorage !== "undefined"
            ? localStorage.getItem("theme")
            : null;
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const isDark = stored ? stored === "dark" : prefersDark;

        document.documentElement.dataset.theme = isDark ? "dark" : "lofi";
        document.documentElement.classList.toggle("dark", isDark);
      };

      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <script>
      import NProgress from "nprogress";
      NProgress.configure({ showSpinner: false, speed: 400 });
      document.addEventListener("astro:before-preparation", () => {
        NProgress.start();
      });
      document.addEventListener("astro:page-load", () => {
        NProgress.done();
      });
    </script>
  </head>
  <body>
    <div class="drawer lg:drawer-open">
      <input id="site-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content flex min-h-dvh flex-col bg-base-100">
        <Header />

        <div class="grow md:flex md:justify-center">
          <main
            class="w-full max-w-content px-6 pt-10 pb-12 lg:px-8"
            data-pagefind-body
          >
            {
              !hidePageHeader && (
                <header class="mb-8">
                  {Astro.slots.has("page-header-prefix") && (
                    <div class="mb-3">
                      <slot name="page-header-prefix" />
                    </div>
                  )}
                  <h1 class="m-0 text-3xl font-bold md:text-4xl">
                    {pageTitle}
                  </h1>
                  {description && (
                    <p class="mt-3 text-base leading-relaxed opacity-70">
                      {description}
                    </p>
                  )}
                  {Astro.slots.has("page-header-details") && (
                    <div class={description ? "mt-4" : "mt-3"}>
                      <slot name="page-header-details" />
                    </div>
                  )}
                </header>
              )
            }

            <slot />

            {
              showComments && siteConfig.giscus.enabled && (
                <div class="mt-8">
                  <Comment />
                </div>
              )
            }
          </main>
        </div>

        <Footer />
      </div>

      <SideBar activeHref={activeHref} />
    </div>

    <SearchPanel />
    <BackToTop />
    <GlobalTooltip />
  </body>
</html>
