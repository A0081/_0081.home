---
import siteConfig from "@config";
import { Icon } from "astro-icon/components";

const links = siteConfig.authorLinks ?? [];
---

<section class="mb-8 flex flex-col items-center gap-4 text-center">
  <div class="avatar">
    <div class="w-32 rounded-full">
      <img
        src={siteConfig.avatar}
        alt={siteConfig.author}
        width="135"
        height="135"
      />
    </div>
  </div>

  <div>
    <h2 class="m-0 text-2xl">{siteConfig.author}</h2>
    <p class="mt-1 opacity-70">{siteConfig.authorBio}</p>
  </div>

  <address class="flex flex-wrap items-center justify-center gap-3 not-italic">
    {
      siteConfig.authorLocation && (
        <span class="flex items-center gap-1.5 text-sm opacity-70">
          <Icon name="lucide:map-pin" class="h-4 w-4" />
          {siteConfig.authorLocation}
        </span>
      )
    }
    {
      links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline btn-sm gap-2"
        >
          {link.icon && <Icon name={link.icon} class="h-4 w-4" />}
          <span>{link.name}</span>
        </a>
      ))
    }
  </address>
</section>
