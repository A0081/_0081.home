---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { getTagHref } from "../utils/tags";

interface Props {
  post: CollectionEntry<"blog">;
  badge?: string;
}

const { post, badge } = Astro.props;
const href = `/blog/${post.id}`;
---

<article
  class="rounded-lg bg-base-100 p-4 transition ease-in-out hover:scale-[102%] hover:shadow-xl md:p-5"
>
  <div class="flex flex-col gap-4 md:flex-row md:items-center">
    <div class="min-w-0 grow">
      <a href={href} class="group/title inline-block">
        <h2
          class="m-0 flex flex-wrap items-center gap-2 text-xl font-bold text-base-content transition-colors group-hover/title:text-primary"
        >
          <span>{post.data.title}</span>
          {
            badge && (
              <span class="badge badge-secondary badge-sm">{badge}</span>
            )
          }
        </h2>
      </a>

      {post.data.description && (
        <p class="mt-1 mb-2 line-clamp-2 text-base opacity-70">
          {post.data.description}
        </p>
      )}

      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <time
          datetime={post.data.pubDate.toISOString()}
          class="text-xs opacity-60"
        >
          {
            post.data.pubDate.toLocaleString("zh-CN", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>

        {
          post.data.tags.length > 0 && (
            <ul class="flex flex-wrap gap-1.5" aria-label="Article tags">
              {post.data.tags.map((tag: string) => (
                <li>
                  <a
                    href={getTagHref(tag)}
                    class="badge badge-outline badge-sm no-underline transition-colors hover:badge-primary"
                  >
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <a
      href={href}
      aria-label={`Read article: ${post.data.title}`}
      class="btn btn-ghost btn-circle shrink-0 self-end md:self-center"
    >
      <Icon name="lucide:chevron-right" class="h-5 w-5" />
    </a>
  </div>
</article>
