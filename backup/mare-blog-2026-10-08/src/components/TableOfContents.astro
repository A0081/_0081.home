---
import { Icon } from "astro-icon/components";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  label?: string;
}

const { headings, label = "目录" } = Astro.props;
const items = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

{
  items.length > 0 && (
    <>
      <details
        data-toc
        class="mb-4 rounded-lg bg-surface shadow-sm min-[1366px]:hidden"
      >
        <summary class="flex cursor-pointer items-center gap-2 px-5 py-3 text-sm font-semibold text-text select-none [&::-webkit-details-marker]:hidden">
          <Icon name="lucide:list" aria-hidden="true" class="h-4 w-4" />
          <span>{label}</span>
        </summary>
        <nav aria-label={label} class="px-3 pb-3">
          <ul class="flex flex-col gap-0.5">
            {items.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  data-toc-link
                  class:list={[
                    "toc-link block rounded-md px-3 py-1.5 text-[0.8125rem] leading-snug text-text transition-colors duration-200 hover:bg-accent/10 hover:text-accent-strong",
                    heading.depth === 3 && "pl-6",
                  ]}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>

      <nav
        id="toc-nav"
        aria-label={label}
        class="fixed top-8 hidden max-h-[calc(100vh-4rem)] overflow-y-auto min-[1366px]:block"
      >
        <p class="mb-2 px-3 text-xs font-semibold tracking-wide text-muted uppercase">
          {label}
        </p>
        <ul class="flex flex-col gap-0.5 border-l border-border">
          {items.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                data-toc-link
                title={heading.text}
                class:list={[
                  "-ml-px toc-link block border-l-2 border-transparent px-3 py-1.5 text-[0.8125rem] leading-snug text-text transition-colors duration-200 hover:border-accent/40 hover:text-accent-strong",
                  heading.depth === 3 && "pl-6",
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </>
  )
}

<script>
  type TocWindow = Window & {
    __tocCleanup?: () => void;
  };

  const typedWindow = window as TocWindow;

  const setupTableOfContents = () => {
    if (typedWindow.__tocCleanup) {
      typedWindow.__tocCleanup();
      delete typedWindow.__tocCleanup;
    }

    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    );
    if (links.length === 0) return;

    const ids: string[] = [];
    for (const link of links) {
      const id = (link.getAttribute("href") ?? "").slice(1);
      if (id && !ids.includes(id)) ids.push(id);
    }
    const targets = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (targets.length === 0) return;

    let frame = 0;
    const updateActiveHeading = () => {
      frame = 0;
      const threshold = 140;
      let activeId = targets[0]?.id;

      for (const target of targets) {
        if (target.getBoundingClientRect().top <= threshold) {
          activeId = target.id;
        } else {
          break;
        }
      }

      for (const link of links) {
        link.classList.toggle(
          "is-active",
          link.getAttribute("href") === `#${activeId}`,
        );
      }
    };

    const onScroll = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateActiveHeading);
    };

    const onClick = (event: MouseEvent) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>("[data-toc-link]");
      if (!link) return;

      const hash = link.getAttribute("href");
      if (!hash || !hash.startsWith("#")) return;

      const target = document.getElementById(hash.slice(1));
      if (!target) return;

      event.preventDefault();
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      target.scrollIntoView({
        behavior: reduceMotion ? "auto" : "smooth",
        block: "start",
      });
      history.pushState(null, "", hash);

      const details = link.closest("details");
      if (details) details.open = false;
    };

    document.addEventListener("click", onClick);
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    updateActiveHeading();

    typedWindow.__tocCleanup = () => {
      document.removeEventListener("click", onClick);
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      if (frame) window.cancelAnimationFrame(frame);
    };
  };

  const cleanupTableOfContents = () => {
    if (typedWindow.__tocCleanup) {
      typedWindow.__tocCleanup();
      delete typedWindow.__tocCleanup;
    }
  };

  document.addEventListener("astro:before-swap", cleanupTableOfContents);
  document.addEventListener("astro:page-load", setupTableOfContents);
  setupTableOfContents();
</script>

<style>
  /*
   * The floating sidebar lives in the empty gutter beside the 60rem content
   * column, so it must never be wider than the space that is actually there.
   * Width shrinks with the viewport; below 1366px the gutter is too narrow and
   * the collapsible inline list takes over instead.
   */
  @media (min-width: 1366px) {
    #toc-nav {
      right: calc(50% + 31rem);
      width: min(13rem, calc(50vw - 31.5rem));
    }
  }

  /* Keep the sidebar scrollable but match the site's muted palette. */
  #toc-nav {
    scrollbar-width: thin;
    scrollbar-color: var(--color-base-300) transparent;
  }

  #toc-nav::-webkit-scrollbar {
    width: 6px;
  }

  #toc-nav::-webkit-scrollbar-track {
    background-color: transparent;
  }

  #toc-nav::-webkit-scrollbar-thumb {
    background-color: var(--color-base-300);
    border-radius: 9999px;
  }

  #toc-nav::-webkit-scrollbar-thumb:hover {
    background-color: color-mix(
      in oklab,
      var(--color-base-content) 60%,
      transparent
    );
  }

  .toc-link.is-active {
    border-left-color: var(--color-primary);
    background-color: color-mix(
      in oklab,
      var(--color-primary) 12%,
      transparent
    );
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
