---
import siteConfig from "@config";
import { Icon } from "astro-icon/components";
---

<div
  class="sticky top-0 z-30 flex h-16 w-full items-center justify-center bg-base-100/90 text-base-content shadow-sm backdrop-blur transition-all duration-100 lg:hidden"
>
  <div class="navbar">
    <div class="navbar-start">
      <label
        for="site-drawer"
        class="btn btn-square btn-ghost"
        aria-label="Open navigation"
      >
        <Icon name="lucide:menu" class="h-5 w-5" />
      </label>
    </div>
    <div class="navbar-center">
      <a class="btn btn-ghost text-xl normal-case" href="/">
        {siteConfig.title}
      </a>
    </div>
    <div class="navbar-end"></div>
  </div>
</div>
