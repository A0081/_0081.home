---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
// `url` may or may not end in a slash (the listings now emit the canonical
// trailing-slash form). Strip it first so the tag base stays `/blog/tag`.
const tag_url = url.replace(/\/$/, "").split("/").slice(0, -1).join("/") + "/tag";
---

{/*
  The card used to be one big <a> with the tag badges nested inside it — invalid
  HTML, and browsers unnest it by closing the outer anchor early, which silently
  shrinks the clickable area to whatever comes before the first badge.

  Instead the title carries the link and its ::after is stretched over the card
  (see .content-card in global.css). The badges are then plain siblings, so the
  whole card stays clickable while each tag remains its own target.
*/}
<div
  class="content-card rounded-lg bg-base-100 transition ease-in-out hover:scale-[102%] hover:shadow-xl"
>
  <div class="hero-content flex-col md:flex-row">
    {
      img && (
        <Image
          src={img}
          width={750}
          height={422}
          format="webp"
          alt={title}
          class="h-auto max-w-full rounded-lg md:max-w-[13rem]"
        />
      )
    }
    <div class="w-full grow">
      <h1 class="text-xl font-bold">
        <a href={url} target={target} class="card-title-link">{title}</a>
        {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
      </h1>
      <p class="text-1xl py-1">{desc}</p>
      <div class="card-actions justify-end">
        {
          tags &&
            tags.map((tag) => (
              <a
                href={`${tag_url}/${encodeURIComponent(tag)}/`}
                class="badge badge-outline"
              >
                {tag}
              </a>
            ))
        }
      </div>
    </div>
  </div>
</div>
