---
import { SITE_AUTHOR } from "../config";

const today = new Date();
---

<footer class="footer footer-center block mb-5 pt-10">
  <div class="pb-2">
    &copy; {today.getFullYear()} {SITE_AUTHOR}
  </div>
  <div class="inline opacity-75">
    Built with <a
      href="https://astrofy-template.netlify.app/"
      target="_blank"
      class="font-bold">Astrofy Template ⚡️</a
    >
    by <span class="font-bold">{SITE_AUTHOR}</span>
  </div>
</footer>
