---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/*
 * Every image in src/assets/picture joins the homepage slideshow automatically,
 * in filename order. Drop a file in and it shows up; rename to reorder.
 */
const modules = import.meta.glob<ImageMetadata>(
  "../assets/picture/*.{png,jpg,jpeg,webp,avif}",
  { eager: true, import: "default" },
);

const photos = Object.keys(modules)
  .sort((a, b) => a.localeCompare(b))
  .map((path) => modules[path]);

// How long each photo stays before the next one fades in.
const holdSeconds = 4;
---

<BaseLayout fullWidth hideFooter>
  <section class="home-slideshow" aria-label="Photos">
    <button
      type="button"
      id="home-slideshow"
      class="home-slideshow-hit"
      data-hold-ms={holdSeconds * 1000}
      aria-label="Show next photo"
    >
      {
        photos.map((photo, index) => (
          <span class:list={["home-slide", index === 0 && "is-active"]}>
            <Image
              src={photo}
              alt=""
              widths={[960, 1440, 1920]}
              sizes="100vw"
              format="webp"
              quality={80}
              loading={index === 0 ? "eager" : "lazy"}
            />
          </span>
        ))
      }
    </button>
  </section>
</BaseLayout>

<style>
  /*
   * Full-bleed fading slideshow. Photos are scaled to the height of the area
   * and aligned to the right, then cross-fade on a loop. Clicking anywhere on
   * the photo moves to the next one. Everything sits inside the content column,
   * so the sidebar is left exactly as it was.
   */
  .home-slideshow {
    position: relative;
    height: calc(100dvh - 4rem);
    overflow: hidden;
  }

  .home-slideshow-hit {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .home-slide {
    position: absolute;
    inset: 18px;
    display: block;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }

  .home-slide.is-active {
    opacity: 1;
  }

  /*
   * Every photo keeps the full height of the frame and lets its width follow the
   * aspect ratio, pinned to the right edge:
   *   - landscape photos end up wider than the frame, so the overflow is
   *     cropped on the left;
   *   - portrait photos end up narrower and simply sit against the right edge.
   */
  .home-slide :global(img) {
    position: absolute;
    top: 0;
    right: 0;
    display: block;
    height: 100%;
    width: auto;
    max-width: none;
  }

  /* The header is mobile-only, so the photo can fill the whole viewport on
     desktop. */
  @media (min-width: 1024px) {
    .home-slideshow {
      height: 100dvh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-slide {
      transition: none;
    }
  }
</style>

<script>
  const HOLD_FALLBACK_MS = 4000;

  const setupSlideshow = () => {
    const container = document.getElementById("home-slideshow");
    if (!container) return;
    if (container.dataset.slideshowReady === "true") return;
    container.dataset.slideshowReady = "true";

    const slides = Array.from(container.querySelectorAll(".home-slide"));
    if (slides.length === 0) return;

    const holdMs = Number(container.dataset.holdMs) || HOLD_FALLBACK_MS;
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let index = Math.max(
      0,
      slides.findIndex((slide) => slide.classList.contains("is-active")),
    );
    let timer;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === index);
      });
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (reduceMotion || slides.length < 2) return;
      timer = window.setInterval(() => show(index + 1), holdMs);
    };

    show(index);
    start();

    container.addEventListener("click", () => {
      show(index + 1);
      // Give the clicked photo a fresh, full turn before the timer resumes.
      start();
    });

    document.addEventListener("astro:before-swap", stop, { once: true });
  };

  setupSlideshow();
  document.addEventListener("astro:page-load", setupSlideshow);
</script>
