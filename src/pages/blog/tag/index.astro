---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getTagHref, getTagSummaries } from "../../../utils/tags";

const posts = await getCollection("blog");
const tags = getTagSummaries(posts);
---

<BaseLayout title="标签">
  <div class="mb-5">
    <div class="w-full text-3xl font-bold">标签</div>
    <p class="mt-2 text-sm text-base-content/55">
      {tags.length} 个标签 · {posts.length} 篇文章
    </p>
  </div>

  {
    tags.length > 0 ? (
      <ul class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li>
            <a
              href={getTagHref(tag.slug)}
              class="badge badge-lg badge-outline gap-2 py-3.5 no-underline transition-colors hover:border-accent-text hover:text-accent-text"
            >
              <span>{tag.name}</span>
              <span class="text-base-content/45 tabular-nums">
                {tag.count}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="w-full min-w-full border-l-4 border-secondary bg-base-200 p-4">
        <p class="font-bold">还没有标签</p>
        <p>
          在文章的 frontmatter 里加上 <code>tags</code>{" "}
          列表，标签就会出现在这里。
        </p>
      </div>
    )
  }
</BaseLayout>
