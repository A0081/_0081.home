---
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../../../../lib/createSlug";
import {
  getPostsForTag,
  getTagHref,
  getTagSummaries,
} from "../../../../utils/tags";

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection("blog");

  // getTagSummaries() de-duplicates, so a tag shared by several posts is
  // paginated exactly once instead of emitting a conflicting route per post.
  return getTagSummaries(allPosts).flatMap((tag) => {
    const posts = getPostsForTag(allPosts, tag.slug);
    return paginate(posts, {
      params: { tag: tag.slug },
      props: { tagName: tag.name },
      pageSize: 10,
    });
  });
}

const { page, tagName } = Astro.props;
---

<BaseLayout title={"文章 - " + tagName} sideBarActiveItemID="tags">
  <div class="mb-5">
    <div class="w-full text-3xl font-bold">文章 - {tagName}</div>
    <a
      href="/blog/tag/"
      class="mt-2 inline-block text-sm text-base-content/55 no-underline transition-colors hover:text-accent-text"
    >
      ← 全部标签
    </a>
  </div>
  {
    page.data.length === 0 ? (
      <div class="w-full min-w-full border-l-4 border-secondary bg-base-200 p-4">
        <p class="font-bold">抱歉</p>
        <p>这个标签下暂时还没有文章。</p>
      </div>
    ) : (
      <ul>
        {page.data.map((post) => (
          <>
            <HorizontalCard
              title={post.data.title}
              img={post.data.heroImage}
              desc={post.data.description}
              url={"/blog/" + createSlug(post.data.title, post.id) + "/"}
              target="_self"
              badge={post.data.badge}
              tags={post.data.tags}
            />
            <div class="divider my-0" />
          </>
        ))}
      </ul>
    )
  }

  <div class="flex justify-between">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="btn btn-ghost mx-5 my-10">
          {" "}
          <svg
            class="h-6 w-6 fill-current md:h-8 md:w-8"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
          </svg>{" "}
          更新的文章
        </a>
      ) : (
        <div />
      )
    }
    {
      page.url.next ? (
        <a href={page.url.next} class="btn btn-ghost mx-5 my-10">
          更早的文章{" "}
          <svg
            class="h-6 w-6 fill-current md:h-8 md:w-8"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            {" "}
            <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
          </svg>
        </a>
      ) : (
        <div />
      )
    }
  </div>
</BaseLayout>
