---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection, type CollectionEntry } from "astro:content";

type ProjectEntry = CollectionEntry<"projects">;

interface ProjectGroup {
  /** Folder name, shown where the layout used to say "Projects Header". */
  name: string;
  items: ProjectEntry[];
}

const entries = await getCollection("projects");

/*
 * Entries live in src/content/projects/<project>/<file>.md, so the first path
 * segment of the entry id is the project folder. Grouping by it means adding a
 * folder — or a file inside one — is all it takes to appear here.
 */
const byFolder = new Map<string, ProjectEntry[]>();

for (const entry of entries) {
  const folder = entry.id.split("/")[0] ?? entry.id;
  const bucket = byFolder.get(folder);
  if (bucket) {
    bucket.push(entry);
  } else {
    byFolder.set(folder, [entry]);
  }
}

const groups: ProjectGroup[] = [...byFolder.entries()]
  .map(([name, items]) => ({
    name,
    items: items.sort(
      (a, b) =>
        a.data.order - b.data.order ||
        a.data.title.localeCompare(b.data.title),
    ),
  }))
  .sort((a, b) => {
    const left = Math.min(...a.items.map((item) => item.data.order));
    const right = Math.min(...b.items.map((item) => item.data.order));
    return left - right || a.name.localeCompare(b.name);
  });
---

<BaseLayout title="项目" sideBarActiveItemID="projects">
  <div class="mb-8 w-full text-3xl font-bold">项目</div>

  {
    groups.map((group, groupIndex) => (
      <>
        {/*
          A section label rather than a second page title: the group name used to
          be text-3xl, exactly the heading above it, so the two read as siblings
          and neither the page nor the groups had a clear rank.
        */}
        <div
          class:list={[
            "mb-3 w-full border-b border-base-300 pb-2 text-sm font-semibold tracking-[0.12em] text-base-content/55",
            groupIndex > 0 && "mt-12",
          ]}
        >
          {group.name}
        </div>

        {group.items.map((entry) => (
          <>
            <HorizontalCard
              title={entry.data.title}
              img={entry.data.heroImage}
              desc={entry.data.description}
              url={`/projects/${entry.id}/`}
              target="_self"
              badge={entry.data.badge}
            />
            <div class="divider my-0" />
          </>
        ))}
      </>
    ))
  }
</BaseLayout>
